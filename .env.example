# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local dev fallback — when Firebase Auth isn't wired in the client yet
# the server treats every request as this user. Leave unset in production.
DEV_USER_ID=

# Firebase client (Dev 2) — from Firebase Console → Project settings
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Dev 2) — server-only, never expose to the browser
# Path to service account JSON, or use GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT_PATH=
# Or paste the full JSON on one line (alternative to path)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Dev 1 AI microservice (soloscale-ai-service) — server-only
AI_SERVICE_URL=http://localhost:4000

# AI APIs (Dev 1) — in-app fallback when AI_SERVICE_URL is unset
GEMINI_API_KEY=
# Optional — comma-separated fallback keys for chat/reports (same pool; retries on quota/network).
GEMINI_FALLBACK_API_KEYS=
# Legacy — merged with fallbacks; leave empty if you only use GEMINI_API_KEY.
GEMINI_IMAGE_API_KEYS=
# Optional — defaults to gemini-2.5-flash. If chat returns HTTP 404 / model not found, try gemini-2.0-flash.
GEMINI_TEXT_MODEL=gemini-2.5-flash
IMAGE_API_KEY=
TTS_API_KEY=

# --- Scheduled reminders (GET/POST /api/cron/dispatch-reminders) ---
# Authorization: Bearer <CRON_SECRET> or ?secret= (Vercel Cron sends Bearer when CRON_SECRET is set).
CRON_SECRET=

# Resend — https://resend.com
RESEND_API_KEY=
# e.g. SoloScale <reminders@yourdomain.com>
EMAIL_FROM=

# ---- Monorepo note ----
# The Express microservice in soloscale-ai-service/ uses prefixed keys
# (SS_AI_SERVICE_*) so they do not conflict with variables above when syncing
# env to Vercel. See soloscale-ai-service/.env.example for Render / local AI.
