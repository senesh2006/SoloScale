# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCKS=true

# Firebase client (Dev 2) — from Firebase Console → Project settings
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Dev 2) — server-only, never expose to the browser
# Path to service account JSON, or use GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT_PATH=
# Or paste the full JSON on one line (alternative to path)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# AI APIs (Dev 1)
GEMINI_API_KEY=
IMAGE_API_KEY=
TTS_API_KEY=
