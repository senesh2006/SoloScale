# =============================================================================
# SoloScale — Next.js app (copy to `.env.local` for local dev, Vercel env UI for prod)
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Auth / dev tooling (never enable bypass in production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BYPASS_AUTH=
DEV_USER_ID=

# Lets API routes impersonate Firebase users without a client token — local only with NODE_ENV=development
ALLOW_DEV_AUTH_FALLBACK=

# -----------------------------------------------------------------------------
# Firebase — client SDK (Firebase Console → Project settings → Web app)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Firebase Admin — API routes only (never expose to the browser)
# -----------------------------------------------------------------------------

FIREBASE_SERVICE_ACCOUNT_PATH=

# Single-line JSON (alternative when you cannot upload a file on the host).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: GCP default credentials instead of vars above — path to SA JSON file
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# AI microservice (`soloscale-ai-service` on localhost or Render URL)
# Server-only — not exposed as NEXT_PUBLIC_*
AI_SERVICE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Gemini — used by Next server routes when the microservice is off or fallback
# Main key: GEMINI_API_KEY preferred; SS_AI_SERVICE_GEMINI_API_KEY also works
# (same name as soloscale-ai-service) for shared Vercel env imports.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

SS_AI_SERVICE_GEMINI_API_KEY=

# Comma-separated extra keys — chat/reports/strategy retries
GEMINI_FALLBACK_API_KEYS=

# Comma-separated pool for quota rotation (strategy/image paths via geminiKeys)
GEMINI_IMAGE_API_KEYS=

# Optional: microservice image pool is merged into the same key list when set on Next.
SS_AI_SERVICE_GEMINI_IMAGE_API_KEYS=

GEMINI_TEXT_MODEL=gemini-2.5-flash

# Or SS_AI_SERVICE_GEMINI_TEXT_MODEL for the same value when matching the service.
SS_AI_SERVICE_GEMINI_TEXT_MODEL=

# -----------------------------------------------------------------------------
# Stub / unused in current codepaths (kept for future wiring)
IMAGE_API_KEY=
TTS_API_KEY=

# -----------------------------------------------------------------------------
# Cron — GET/POST /api/cron/dispatch-reminders
# Bearer <CRON_SECRET> or ?secret=
CRON_SECRET=

# -----------------------------------------------------------------------------
# Email — Resend (reminders etc.)
RESEND_API_KEY=

EMAIL_FROM=

# =============================================================================
# Monorepo: soloscale-ai-service uses SS_AI_SERVICE_* names — see
# soloscale-ai-service/.env.example. Next.js prefers GEMINI_* but accepts the
# SS_AI_SERVICE_* Gemini vars above for shared Vercel imports.
# =============================================================================
