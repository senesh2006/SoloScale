rules_version = '2';

// ----------------------------------------------------------------------------
// SoloScale Firestore security rules
//
// Default-deny everything. Each collection explicitly whitelists what
// authenticated users can read / write. Writes always go through our Next.js
// API (which uses Firebase Admin and bypasses these rules), so client-side
// writes are restricted to the bare minimum needed for direct reads from the
// web client (currently just listing campaigns/events you own).
//
// Event ownership is defined by the parent campaign's user_id (single source
// of truth). Event docs also store user_id for convenience, but rules do not
// rely on it so older rows without user_id remain protected.
// ----------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsCampaign(campaignId) {
      return signedIn()
        && get(/databases/$(database)/documents/campaigns/$(campaignId))
             .data.user_id == request.auth.uid;
    }

    /** True when the signed-in user owns the campaign that owns this event. */
    function ownsEvent(eventId) {
      return signedIn()
        && ownsCampaign(
          get(/databases/$(database)/documents/events/$(eventId)).data.campaign_id
        );
    }

    // ---------------- users/{uid} ----------------
    // A user can read/update their own profile. Creates flow through the
    // Next.js API, so deny client-side create.
    match /users/{uid} {
      allow read, update: if isOwner(uid);
      allow create, delete: if false;
    }

    // ---------------- campaigns/{campaignId} ----------------
    match /campaigns/{campaignId} {
      allow read, update, delete:
        if signedIn() && resource.data.user_id == request.auth.uid;
      allow create:
        if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    // ---------------- events/{eventId} ----------------
    // PUBLIC: anyone can read a published event (powers landing pages).
    // ORGANIZER: full read/write of drafts via parent campaign ownership.
    match /events/{eventId} {
      allow read:
        if resource.data.published == true
           || (signedIn() && ownsCampaign(resource.data.campaign_id));
      allow create:
        if signedIn()
          && request.resource.data.user_id == request.auth.uid
          && ownsCampaign(request.resource.data.campaign_id);
      allow update, delete:
        if signedIn() && ownsCampaign(resource.data.campaign_id);
    }

    // ---------------- assets/{assetId} ----------------
    match /assets/{assetId} {
      allow read, write:
        if signedIn() && resource.data.user_id == request.auth.uid;
    }

    function eventPublished(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.published == true;
    }

    // ---------------- attendees/{attendeeId} ----------------
    // Create only for published events (registration). Reads/updates: organizer.
    match /attendees/{attendeeId} {
      allow create: if eventPublished(request.resource.data.event_id);
      allow read:   if ownsEvent(resource.data.event_id);
      allow update: if ownsEvent(resource.data.event_id);
      allow delete: if false;
    }

    // ---------------- form_responses/{responseId} ----------------
    // Create only for published events. Reads: host uid or campaign owner.
    match /form_responses/{responseId} {
      allow create: if eventPublished(request.resource.data.event_id);
      allow read:   if signedIn() && (
        resource.data.user_id == request.auth.uid
        || ownsEvent(resource.data.event_id)
      );
      allow update: if signedIn() && (
        resource.data.user_id == request.auth.uid
        || ownsEvent(resource.data.event_id)
      );
      allow delete: if false;
    }

    // ---------------- announcements/{announcementId} ----------------
    match /announcements/{announcementId} {
      allow read, write:
        if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // ---------------- event_reminders/{reminderId} ----------------
    match /event_reminders/{reminderId} {
      allow read, write:
        if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // ---------------- billing collections ----------------
    // All billing flows live behind the API. Deny direct client access.
    match /subscriptions/{id}     { allow read, write: if false; }
    match /payment_methods/{id}   { allow read, write: if false; }
    match /invoices/{id}          { allow read, write: if false; }
    match /payments/{id}          { allow read, write: if false; }
  }
}
