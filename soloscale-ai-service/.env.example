# Required: Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: HTTP port (default 4000)
PORT=4000

# Optional: Public base URL the service is reachable at.
# Used to build absolute URLs for files saved by LocalStorageAdapter.
# Default: http://localhost:${PORT}
PUBLIC_BASE_URL=

# Optional: Storage driver. Currently supported: "local"
# Dev 2 will add "supabase" later by implementing StorageAdapter.
STORAGE_DRIVER=local

# Optional: Gemini text model for strategy (default gemini-2.5-flash).
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Optional: extra Gemini keys for strategy fallback when the main key hits 429.
# Comma-separated. Each key should be from a separate Google Cloud project.
# Example: GEMINI_IMAGE_API_KEYS=AIza_key_from_account_1,AIza_key_from_account_2
GEMINI_IMAGE_API_KEYS=

# Required for flyer images: Pixazo API key (https://api-console.pixazo.ai/api_keys)
# Flyers use ONLY the free Flux 1 Schnell model ($0/image). No paid Pixazo or Gemini image models.
PIXAZO_API_KEY=

# Optional: output size (each side clamped to 1024 max for free tier). Defaults: 576x1024 (9:16).
# PIXAZO_FLYER_WIDTH=576
# PIXAZO_FLYER_HEIGHT=1024
# PIXAZO_NUM_STEPS=4

# Required for voice-over: ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Optional: default voice ID (any voice from https://elevenlabs.io/app/voice-lab).
# Default = Rachel (warm female, narrator-friendly).
# Other built-ins: Adam pNInz6obpgDQGcFmaJgB, Antoni ErXwobaYiN019PkySvjV,
# Bella EXAVITQu4vr4xnSDxMaL, Domi AZnzlk1XvdvUeBnXmlld.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: model id. eleven_multilingual_v2 = best general quality.
# Other options: eleven_turbo_v2_5 (faster/cheaper), eleven_v3 (newest, expressive).
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: output format. mp3_44100_128 = 44.1kHz / 128 kbps MP3 (browser native).
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
