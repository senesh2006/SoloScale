# soloscale-ai-service — env vars are prefixed SS_AI_SERVICE_ so they never
# duplicate keys from the Next.js root `.env.example` (e.g. Vercel imports).
#
# Prefixed vars are preferred; legacy names (GEMINI_API_KEY, etc.) still work
# at runtime when the prefixed variable is unset (e.g. existing Render setups).

SS_AI_SERVICE_GEMINI_API_KEY=

# HTTP port for the Express server (default 4000)
PORT=4000

# URLs for saved files — default http://localhost:${PORT}
PUBLIC_BASE_URL=

STORAGE_DRIVER=local

SS_AI_SERVICE_GEMINI_TEXT_MODEL=gemini-2.5-flash

# Comma-separated keys for flyer / quota rotation (each from a separate GCP project if possible)
SS_AI_SERVICE_GEMINI_IMAGE_API_KEYS=

# Pixazo Flux 1 Schnell (flyer images) — https://api-console.pixazo.ai/api_keys
SS_AI_SERVICE_PIXAZO_API_KEY=

# SS_AI_SERVICE_PIXAZO_FLYER_WIDTH=576
# SS_AI_SERVICE_PIXAZO_FLYER_HEIGHT=1024
# SS_AI_SERVICE_PIXAZO_NUM_STEPS=4

SS_AI_SERVICE_ELEVENLABS_API_KEY=

SS_AI_SERVICE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
SS_AI_SERVICE_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
SS_AI_SERVICE_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Optional: curl-based fetch instead of Node TLS (defaults to true)
# USE_CURL_FETCH=false
