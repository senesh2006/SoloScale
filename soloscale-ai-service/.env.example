# =============================================================================
# soloscale-ai-service — Standalone Express API (Gemini strategy, Pixazo flyers, ElevenLabs TTS)
# Copy to `.env` locally. Render: set variables in Dashboard (not NEXT_PUBLIC_*).
#
# PREFIX = SS_AI_SERVICE_* — avoids clashes with SoloScale `.env.example` / Vercel bulk import.
# Runtime still honors legacy GEMINI_* / ELEVENLABS_* / PIXAZO_* if prefixed vars are empty.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
SS_AI_SERVICE_GEMINI_API_KEY=

SS_AI_SERVICE_PIXAZO_API_KEY=

SS_AI_SERVICE_ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# Server
PORT=4000

# Used in saved asset URLs (default http://localhost:${PORT})

PUBLIC_BASE_URL=

STORAGE_DRIVER=local

# -----------------------------------------------------------------------------
# Gemini (strategy + image pool)
SS_AI_SERVICE_GEMINI_TEXT_MODEL=gemini-2.5-flash

# Comma-separated keys for flyers / quota rotation (separate GCP projects ideal)
SS_AI_SERVICE_GEMINI_IMAGE_API_KEYS=

# -----------------------------------------------------------------------------
# ElevenLabs
SS_AI_SERVICE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

SS_AI_SERVICE_ELEVENLABS_MODEL_ID=eleven_multilingual_v2

SS_AI_SERVICE_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# -----------------------------------------------------------------------------
# Pixazo flyer size overrides (Flux 1 Schnell free tier clamps apply)
SS_AI_SERVICE_PIXAZO_FLYER_WIDTH=

SS_AI_SERVICE_PIXAZO_FLYER_HEIGHT=

SS_AI_SERVICE_PIXAZO_NUM_STEPS=

# -----------------------------------------------------------------------------
# HTTP transport (Windows Defender / TLS quirks — see docs/troubleshooting.md)
USE_CURL_FETCH=true
